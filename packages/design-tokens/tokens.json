{
  "meta": {
    "name": "RailOS Design Tokens",
    "version": "1.0.0",
    "description": "Single source of truth for RailOS design system across Next.js Control Center and Flutter Field App"
  },
  "colors": {
    "primary": {
      "navy": "#0B1528",
      "steel": "#1E293B",
      "railBlue": "#1D4ED8",
      "signalAmber": "#D97706",
      "safetyRed": "#DC2626",
      "trackGreen": "#059669"
    },
    "background": {
      "darkRoot": "#070D18",
      "darkSurface": "#0F172A",
      "darkElevated": "#1E293B",
      "darkBorder": "#334155",
      "lightRoot": "#F8FAFC",
      "lightSurface": "#FFFFFF",
      "lightElevated": "#F1F5F9",
      "lightBorder": "#E2E8F0"
    },
    "text": {
      "darkPrimary": "#F8FAFC",
      "darkSecondary": "#94A3B8",
      "darkMuted": "#64748B",
      "lightPrimary": "#0F172A",
      "lightSecondary": "#475569",
      "lightMuted": "#94A3B8"
    },
    "status": {
      "verified": {
        "bg": "#064E3B",
        "border": "#059669",
        "fg": "#34D399",
        "text": "#ECFDF5"
      },
      "verifying": {
        "bg": "#1E3A8A",
        "border": "#2563EB",
        "fg": "#60A5FA",
        "text": "#EFF6FF"
      },
      "flagged": {
        "bg": "#581C87",
        "border": "#7C3AED",
        "fg": "#A78BFA",
        "text": "#F5F3FF"
      },
      "caution": {
        "bg": "#78350F",
        "border": "#D97706",
        "fg": "#FBBF24",
        "text": "#FFFBEB"
      },
      "rejected": {
        "bg": "#7F1D1D",
        "border": "#DC2626",
        "fg": "#F87171",
        "text": "#FEF2F2"
      },
      "draft": {
        "bg": "#1E293B",
        "border": "#475569",
        "fg": "#94A3B8",
        "text": "#F8FAFC"
      }
    },
    "evidenceStrip": {
      "overlayBg": "rgba(0, 0, 0, 0.82)",
      "overlayText": "#FFFFFF",
      "overlayAccent": "#38BDF8",
      "overlayWarning": "#FBBF24",
      "overlayAlert": "#F87171"
    }
  },
  "dimensions": {
    "minTouchTargetDp": 48,
    "evidenceStripHeightDp": 64,
    "photoPreviewMaxHeightDp": 400,
    "videoOverlayFontSizeSp": 14,
    "borderRadiusSm": 4,
    "borderRadiusMd": 8,
    "borderRadiusLg": 12,
    "spacingXs": 4,
    "spacingSm": 8,
    "spacingMd": 16,
    "spacingLg": 24,
    "spacingXl": 32
  },
  "geo": {
    "defaultTaskRadiusMeters": 100.0,
    "targetGpsAccuracyMeters": 50.0,
    "maxFixAgeSeconds": 30,
    "maxClockDriftSeconds": 300,
    "videoSampleIntervalSeconds": 5
  },
  "media": {
    "maxVideoDurationSeconds": 90,
    "videoResolutionWidth": 1280,
    "videoResolutionHeight": 720,
    "photoCompressionQuality": 85,
    "multipartChunkSizeBytes": 8388608
  }
}
