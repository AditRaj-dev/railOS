# RailOS Environment Variables Template

# Backend API Configuration
PORT=8000
RAILOS_STORAGE_BACKEND=memory
# For production PostgreSQL:
# RAILOS_STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql://railos:railos@localhost:5432/railos

# Frontend Control Center Configuration
NEXT_PUBLIC_RAILOS_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE_URL=street
NEXT_PUBLIC_RAILOS_MODE=synthetic

# Optional AI Gemini Pro Integration
GEMINI_API_KEY=
