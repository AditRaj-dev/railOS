# RailOS API & Optimization Engine
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy python project definition, packages, and integration adapters
COPY pyproject.toml ./
COPY packages/ ./packages/
COPY config/ ./config/
COPY datasets/ ./datasets/
COPY schemas/ ./schemas/
COPY integrations/ ./integrations/
COPY apps/api/ ./apps/api/

# Install python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e . && \
    pip install --no-cache-dir -r apps/api/requirements.txt

ENV PORT=8000
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["sh", "-c", "python -m uvicorn railos_api.main:app --app-dir apps/api --host 0.0.0.0 --port ${PORT:-8000}"]
