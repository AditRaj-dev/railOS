# RailOS API & Optimization Engine
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy python project definition and packages
COPY pyproject.toml ./
COPY packages/ ./packages/
COPY config/ ./config/
COPY datasets/ ./datasets/
COPY schemas/ ./schemas/
COPY apps/api/ ./apps/api/

# Install python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e . && \
    pip install --no-cache-dir -r apps/api/requirements.txt

ENV PORT=8000
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "railos_api.main:app", "--app-dir", "apps/api", "--host", "0.0.0.0", "--port", "8000"]
